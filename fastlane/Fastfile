# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "My awesome app"
  lane :distribute do |options|
    gradle(
      task: 'bundle',
      build_type: 'Release',
    )
    # build_android_app is a built-in fastlane action.
    firebase_token = options[:firebase_cli_token]
    release = firebase_app_distribution(
      app: "1:16729881194:android:8fa0a8f6ff9d3778292813",
      groups: "compose-calculator-testers",
      android_artifact_type: "AAB",
      android_artifact_path: "androidApp/build/outputs/bundle/release/androidApp-release.aab",
      firebase_cli_token: firebase_token
    )
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :internal do
    gradle(
      task: 'bundle',
      build_type: 'Release',
    )
    upload_to_play_store(track: 'internal')
  end

  desc "Captures the Play Store phone screenshots on a connected device or emulator (serial:<adb serial> picks one)"
  lane :screenshots do |options|
    serial = options[:serial]
    adb_args = serial ? { serial: serial } : {}
    gradle(tasks: ["assembleDebug", "assembleDebugAndroidTest"])
    # Play rejects screenshots whose long side is more than twice the short side,
    # so capture at 1080x1920 (9:16) and then put back whatever the device had.
    override = ->(output) { output[/Override \w+: (\S+)/, 1] || "reset" }
    original_size = override.call(adb(command: "shell wm size", **adb_args))
    original_density = override.call(adb(command: "shell wm density", **adb_args))
    original_night = adb(command: "shell cmd uimode night", **adb_args)[/Night mode: (\w+)/, 1] || "no"
    adb(command: "shell wm size 1080x1920", **adb_args)
    adb(command: "shell wm density 420", **adb_args)
    begin
      capture_android_screenshots(specific_device: serial)
    ensure
      adb(command: "shell wm size #{original_size}", **adb_args)
      adb(command: "shell wm density #{original_density}", **adb_args)
      adb(command: "shell cmd uimode night #{original_night}", **adb_args)
    end
  end
end
